{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Generate Data",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/generate_data.ts",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Generate SVG",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--import", "tsx"],
      "args": ["--filename=travels.json"],
      "program": "${workspaceFolder}/generate_svg.ts",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Generate SVG and Map",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--import", "tsx"],
      "args": ["--filename=travels.json", "--staticmap=true"],
      "program": "${workspaceFolder}/generate_svg.ts",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Generate Cycling Stage Maps",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--import", "tsx"],
      "args": [
        "--filename=travels.json",
        "--staticmap=true",
        "--stageMaps=true",
        "--specificMap=2018-london_to_rome"
      ],
      "program": "${workspaceFolder}/generate_svg.ts",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Print Strava Activity IDs",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--import", "tsx"],
      "args": ["--from=2025-05-30", "--to=2025-06-03"],
      "program": "${workspaceFolder}/print_strava_ids.ts",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Generate Elevation Profiles",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/generate_elevation_svg.ts",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
