{
  "compilerOptions": {
    "target": "ES2020", // Or newer
    "module": "ESNext", // Use modern Node.js module system
    "moduleResolution": "Bundler",
    "outDir": "./dist", // Output directory for compiled JS
    "rootDir": "./", // Source directory
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["lib/*"],
      "@/*": ["web/src/*"]
    }
  },
  "include": ["*.ts", "lib/**/*.ts", "generate_elevation_svg.ts", "generate_svg.ts"],
  "exclude": ["node_modules", "dist", "web"]
}
