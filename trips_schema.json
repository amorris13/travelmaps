{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trips Schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "startDate": {
        "type": "string"
      },
      "endDate": {
        "type": "string"
      },
      "waypoints": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "location": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lng": {
                  "type": "number"
                }
              },
              "required": ["lat", "lng"]
            },
            "mode": {
              "type": "string"
            },
            "strava_activity_id": {
              "type": "string"
            },
            "strava_data": {
              "type": "object",
              "properties": {
                "distance_stream": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "elevation_stream": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "total_elevation_gain": {
                  "type": "number"
                },
                "distance": {
                  "type": "number"
                },
                "max_elevation": {
                  "type": "number"
                },
                "moving_time": {
                  "type": "number"
                }
              },
              "required": ["distance", "elevation"]
            },
            "stops": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "location": {
                    "type": "object",
                    "properties": {
                      "lat": {
                        "type": "number"
                      },
                      "lng": {
                        "type": "number"
                      }
                    },
                    "required": ["lat", "lng"]
                  }
                },
                "required": ["name"]
              }
            },
            "polyline": {
              "type": "string"
            },
            "hideLabel": {
              "type": "boolean"
            },
            "hidePolyline": {
              "type": "boolean"
            },
            "geocodeName": {
              "type": "string"
            },
            "showWaypointOnOverview": {
              "type": "boolean"
            },
            "dayStop": {
              "type": "boolean"
            },
            "partialAttendance": {
              "type": "boolean"
            },
            "hidePolylineOnOverview": {
              "type": "boolean"
            },
            "hideWaypoint": {
              "type": "boolean"
            }
          },
          "required": ["name", "location"]
        }
      },
      "hideLabel": {
        "type": "boolean"
      },
      "hideOnOverview": {
        "type": "boolean"
      },
      "isHome": {
        "type": "boolean"
      }
    },
    "required": ["name", "startDate", "endDate", "waypoints"]
  }
}
