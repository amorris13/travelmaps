{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["../lib/*"],
      "simplify-js": ["./node_modules/simplify-js"],
      "string-pixel-width": ["./node_modules/string-pixel-width"],
      "@mapbox/polyline": ["./node_modules/@mapbox/polyline"],
      "seedrandom": ["./node_modules/seedrandom"],
      "svg-intersections": ["./node_modules/svg-intersections"]
    },
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../lib/**/*.ts"],
  "exclude": ["node_modules"]
}
